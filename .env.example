# Set DATABASE_URL for PostgreSQL deployment. Leave unset for local SQLite.
DATABASE_URL=
# Optional local fallback when DATABASE_URL is unset.
ANOMALY_DATABASE_PATH=data/telemetry.sqlite
# Comma-separated frontend origins; do not use "*" with credentials.
ANOMALY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANOMALY_CORS_ALLOW_CREDENTIALS=false

# Optional non-secret overrides
ANOMALY_RANDOM_SEED=42
ANOMALY_STATION_COUNT=3
ANOMALY_OBSERVATIONS_PER_STATION=24
ANOMALY_RATE=0.05
ANOMALY_LOG_LEVEL=INFO

# Optional Phase 2 inclusive rule thresholds. Values outside the bounds are predicted anomalies.
ANOMALY_TEMPERATURE_MIN=-40
ANOMALY_TEMPERATURE_MAX=50
ANOMALY_HUMIDITY_MIN=0
ANOMALY_HUMIDITY_MAX=100
ANOMALY_WIND_SPEED_MIN=0
ANOMALY_WIND_SPEED_MAX=35
ANOMALY_PRESSURE_MIN=900
ANOMALY_PRESSURE_MAX=1100
ANOMALY_HEAT_STRESS_TEMPERATURE_MIN=35
ANOMALY_HEAT_STRESS_HUMIDITY_MIN=80
